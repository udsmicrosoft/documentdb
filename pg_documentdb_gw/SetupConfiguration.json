{
  "NodeHostName": "localhost",
  "BlockedRolePrefixes": [
    "documentdb",
    "citus",
    "pg",
    "internal_role"
  ],
  "PostgresPort": 9712,
  "GatewayListenPort": 10260,
  "EnableV2Runtime": true,
  "HostConfigurationWatchIntervalMs": 1000,
  "CertificateOptions": {
    "CertType": "PemAutoGenerated"
  },
  "UseLocalHost": false,
  "_comment_TelemetryOptions": "Telemetry is opt-in through OTEL_METRICS_ENABLED and OTEL_TRACES_ENABLED. Explicit JSON settings take precedence over environment variables.",
  "TelemetryOptions": {
    "ServiceName": "documentdb_gateway",
    "Metrics": {
      "OtlpEndpoint": "http://localhost:4317",
      "ExportIntervalMs": 15000
    },
    "Tracing": {
      "OtlpEndpoint": "http://localhost:4317",
      "SamplerRatio": 1.0,
      "ExportTimeoutMs": 10000
    }
  }
}